# Copie ce fichier en « .env » et remplis les valeurs. Ne partage JAMAIS le .env (le token donne le contrôle du bot).

# Discord Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > ton application > General Information > Application ID
CLIENT_ID=

# (Conseillé) ID de ton serveur : la commande apparaît tout de suite. Sans lui, jusqu'à 1 h d'attente.
GUILD_ID=

# (Optionnel) ID du salon où le bot annonce automatiquement « candidatures ouvertes / fermées »
ANNOUNCE_CHANNEL_ID=

# (Optionnel) Adresse de ton site : ajoute un bouton « Ouvrir le site » sous les messages
SITE_URL=

# (Optionnel) Toutes les combien de secondes le bot vérifie le site (minimum 15, défaut 30)
POLL_SECONDS=30
